# Copy thành .env và sửa khi cần. Không có .env thì docker compose dùng giá trị mặc định (demo).

APP_NAME=THO NHANH API
DEBUG=true
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-chay-that-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CSDL (Docker) ---
POSTGRES_USER=thonhanh
POSTGRES_PASSWORD=thonhanh
POSTGRES_DB=thonhanh
# Chạy API ngoài Docker thì cần dòng này:
DATABASE_URL=postgresql+psycopg://thonhanh:thonhanh@localhost:5432/thonhanh

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081","http://localhost:8082"]

# --- Ảnh tải lên ---
# Địa chỉ mà điện thoại / web admin truy cập được API, VD http://192.168.1.10:8000 (để trống = tự lấy theo request)
PUBLIC_BASE_URL=

# --- Nạp dữ liệu demo khi khởi động (true/false) ---
SEED_DEMO=true

# --- Đăng nhập Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# --- Đăng nhập Facebook (developers.facebook.com > My Apps) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Gửi email mã quên mật khẩu (VD Gmail: smtp.gmail.com, 587, mật khẩu ứng dụng) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Thông báo đẩy qua Expo Push (cần development build để nhận được) ---
PUSH_ENABLED=false

# --- Thuật toán / điều phối ---
LOCATION_MAX_AGE_MINUTES=10
DISPATCH_MAX_WAIT_MINUTES=15
COMMISSION_RATE=0.15
